    <!-- Production config -->
<base-config cleartextTrafficPermitted="false">
<trust-anchors>
    <certificates src="system" />
    <certificates src="user" />
</trust-anchors>
</base-config>

    <!-- Allow cleartext for specific domains if needed -->
<domain-config cleartextTrafficPermitted="false">
<domain includeSubdomains="true">api.findus.com</domain>
<domain includeSubdomains="true">storage.googleapis.com</domain>
<domain includeSubdomains="true">firebasestorage.googleapis.com</domain>
</domain-config>
    </network-security-config>
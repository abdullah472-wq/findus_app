<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude shared preferences (sensitive data) -->
    <exclude domain="sharedpref" path="."/>

    <!-- Include app files -->
    <include domain="file" path="."/>

    <!-- Exclude cache -->
    <exclude domain="database" path="."/>
    <exclude domain="root" path="."/>
</full-backup-content>